# ---------------------------------------------------------------------------
# Clerk authentication
# ---------------------------------------------------------------------------
# Create a Clerk application at https://dashboard.clerk.com and copy the
# Publishable Key here. When this value is blank or invalid, the application
# automatically uses its built-in demo authentication mode so it still runs.
VITE_CLERK_PUBLISHABLE_KEY=VITE_CLERK_PUBLISHABLE_KEY=pk_test_bXV0dWFsLXB1Zy05NDYxLmNsZXJrLmFjY291bnRzLmRldiQ

# Optional: route used after signing out (defaults to the current page)
VITE_CLERK_AFTER_SIGN_OUT_URL=/

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Project URL and anon/publishable API key from
# https://supabase.com/dashboard/project/_/settings/api.
# Run supabase/schema.sql in the Supabase SQL editor before starting the app.
# When these values are blank or placeholders, the application automatically
# falls back to a localStorage-backed demo database seeded with the same data.
